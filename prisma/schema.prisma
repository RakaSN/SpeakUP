generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// RBAC (Role-Based Access Control)
// ==========================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., 'ticket.create', 'ticket.delete', 'master.manage'
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ==========================================
// USERS & AUDIT
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}


model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  // Relations
  userRoles       UserRole[]
  ticketsReported Ticket[]           @relation("TicketReporter")
  assignments     TicketAssignment[] @relation("AssignedTo")
  dispositions    TicketAssignment[] @relation("AssignedBy")
  activities      TicketActivity[]
  notifications   Notification[]
  attachments     TicketAttachment[] @relation("AttachmentUploader")
  auditLogs       AuditLog[]

  @@map("users")
}

// ==========================================
// MASTER DATA
// ==========================================

model MasterTicketType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  tickets Ticket[]

  @@map("master_ticket_types")
}

model MasterTicketCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  tickets Ticket[]

  @@map("master_ticket_categories")
}

model MasterTicketStatus {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  tickets Ticket[]

  @@map("master_ticket_statuses")
}

model MasterTicketPriority {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  slaHours    Int       @default(24) @map("sla_hours")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  tickets Ticket[]

  @@map("master_ticket_priorities")
}

// ==========================================
// CORE TRANSACTIONS
// ==========================================

enum Visibility {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  STRICTLY_CONFIDENTIAL
}

enum SlaStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
  RESOLVED_ON_TIME
  RESOLVED_LATE
}


model Ticket {
  id           String     @id @default(uuid())
  ticketNumber String     @unique @map("ticket_number")
  reporterId   String     @map("reporter_id")
  typeId       String     @map("type_id")
  categoryId   String     @map("category_id")
  statusId     String     @map("status_id")
  priorityId   String     @map("priority_id")
  
  title        String
  description  String     @db.Text
  isAnonymous  Boolean    @default(false) @map("is_anonymous")
  visibility   Visibility @default(PUBLIC)
  
  slaHours           Int?       @map("sla_hours")
  targetResolutionAt DateTime?  @map("target_resolution_at")
  slaStatus          SlaStatus  @default(ON_TRACK) @map("sla_status")
  
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  resolvedAt   DateTime?  @map("resolved_at")
  closedAt     DateTime?  @map("closed_at")

  // Relations
  reporter     User                 @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type         MasterTicketType     @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     MasterTicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status       MasterTicketStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  priority     MasterTicketPriority @relation(fields: [priorityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  
  assignments  TicketAssignment[]
  activities   TicketActivity[]
  attachments  TicketAttachment[]
  aiRecommendations AiRecommendation[]


  @@index([reporterId])
  @@index([typeId])
  @@index([categoryId])
  @@index([statusId])
  @@index([priorityId])
  @@index([slaStatus])
  @@index([targetResolutionAt])
  @@map("tickets")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  fileType     String   @map("file_type")
  fileSize     Int      @map("file_size") // In bytes
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  // Relations
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploader     User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([uploadedById])
  @@map("ticket_attachments")
}

model TicketAssignment {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  assigneeId   String   @map("assignee_id")
  assignedById String   @map("assigned_by_id")
  note         String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  // Relations
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignee     User     @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([assigneeId])
  @@index([assignedById])
  @@map("ticket_assignments")
}

model TicketActivity {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  actorId     String   @map("actor_id")
  actionCode  String   @map("action_code")  // e.g. STATUS_CHANGED
  actionLabel String   @map("action_label") // e.g. Status diubah
  note        String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([actorId])
  @@map("ticket_activities")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType @default(INFO)
  title     String
  message   String    @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?  @map("actor_id")
  action         String
  entity         String?
  entityId       String?  @map("entity_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ==========================================
// BACKGROUND JOBS & SCHEDULER (Sprint 3B)
// ==========================================

model JobConfiguration {
  id             String    @id @default(uuid())
  jobCode        String    @unique @map("job_code")
  name           String
  description    String?   @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  cronExpression String?   @map("cron_expression") // e.g. "* * * * *"
  intervalMs     Int?      @map("interval_ms")     // e.g. 60000 (1 min fallback)
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  heartbeatAt    DateTime? @map("heartbeat_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  logs           JobExecutionLog[]

  @@map("job_configurations")
}

model JobExecutionLog {
  id          String   @id @default(uuid())
  jobCode     String   @map("job_code")
  status      String   // "SUCCESS", "FAILED"
  message     String?  @db.Text
  metadata    Json?
  durationMs  Int?     @map("duration_ms")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime @default(now()) @map("completed_at")

  job         JobConfiguration @relation(fields: [jobCode], references: [jobCode], onDelete: Cascade, onUpdate: Cascade)

  @@index([jobCode])
  @@index([status])
  @@index([startedAt])
  @@map("job_execution_logs")
}

// ==========================================
// AI INTELLIGENCE PLATFORM (Sprint 3C)
// ==========================================

enum AiCapabilityType {
  CLASSIFICATION
  SUMMARIZATION
  TREND_ANALYSIS
  RECOMMENDATION
}

enum AiUserAction {
  PENDING
  ACCEPTED
  REJECTED
  OVERRIDDEN
}

model AiRecommendation {
  id                 String           @id @default(uuid())
  ticketId           String?          @map("ticket_id")
  capability         AiCapabilityType
  modelName          String           @map("model_name")
  promptVersion      String           @map("prompt_version")
  confidenceScore    Float            @default(0.0) @map("confidence_score")
  recommendationData Json             @map("recommendation_data")
  userAction         AiUserAction     @default(PENDING) @map("user_action")
  actionReason       String?          @db.Text @map("action_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  ticket             Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([ticketId])
  @@index([capability])
  @@index([userAction])
  @@map("ai_recommendations")
}

enum AiTelemetryStatus {
  SUCCESS
  FAILED
  RATE_LIMITED
  TIMEOUT
}

model AiTelemetryLog {
  id            String            @id @default(uuid())
  capability    AiCapabilityType?
  modelName     String            @map("model_name")
  promptVersion String            @default("v1.0") @map("prompt_version")
  tokensUsed    Int               @default(0) @map("tokens_used")
  durationMs    Int               @default(0) @map("duration_ms")
  estimatedCost Float             @default(0.0) @map("estimated_cost")
  status        AiTelemetryStatus @default(SUCCESS)
  errorMessage  String?           @db.Text @map("error_message")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([capability])
  @@index([status])
  @@index([createdAt])
  @@map("ai_telemetry_logs")
}
